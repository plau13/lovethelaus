{
  "name": "kitchen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3000",
    "start": "next start --port 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "bash -c 'set -a && [ -f .env ] && . ./.env; [ -f .env.local ] && . ./.env.local; set +a && drizzle-kit generate'",
    "db:migrate": "bash -c 'set -a && [ -f .env ] && . ./.env; [ -f .env.local ] && . ./.env.local; set +a && drizzle-kit migrate'",
    "db:push": "bash -c 'set -a && [ -f .env ] && . ./.env; [ -f .env.local ] && . ./.env.local; set +a && drizzle-kit push'",
    "db:studio": "bash -c 'set -a && [ -f .env ] && . ./.env; [ -f .env.local ] && . ./.env.local; set +a && drizzle-kit studio'",
    "db:seed:demo": "bash -c 'set -a && [ -f .env ] && . ./.env; [ -f .env.local ] && . ./.env.local; set +a && tsx scripts/seed-demo.ts'",
    "db:purge-seed-users": "bash -c 'set -a && [ -f .env ] && . ./.env; [ -f .env.local ] && . ./.env.local; set +a && tsx scripts/purge-seed-users.ts'",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "icons": "node scripts/generate-icons.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@neondatabase/serverless": "^1.1.0",
    "@opennextjs/cloudflare": "^1.20.5",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.128.0"
  }
}
