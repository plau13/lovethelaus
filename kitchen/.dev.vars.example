# Local OpenNext preview only (npm run preview) — do NOT put production secrets here.
# Production secrets are stored as Cloudflare Worker secrets (see docs/CLOUDFLARE.md).
NEXTJS_ENV=development
DATABASE_URL=""
BETTER_AUTH_SECRET=""
APP_URL="http://localhost:8787/kitchen"
RESEND_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
DEMO_USER_EMAIL=demo@lovethelaus.com
DEMO_USER_PASSWORD=your-demo-password
# Optional — server-side Sentry (same DSN as NEXT_PUBLIC_SENTRY_DSN for preview)
SENTRY_DSN=""
SENTRY_ENVIRONMENT=development
