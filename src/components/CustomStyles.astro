---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro).

// Kitchen-aligned warm palette (paper, ink, clay).
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-source-sans);
    --aw-font-serif: var(--font-source-serif);
    --aw-font-heading: var(--font-source-serif);

    --aw-color-primary: rgb(139 58 42);
    --aw-color-secondary: rgb(110 44 32);
    --aw-color-accent: rgb(139 58 42);

    --aw-color-text-heading: rgb(44 24 16);
    --aw-color-text-default: rgb(44 24 16);
    --aw-color-text-muted: rgb(107 83 72);
    --aw-color-bg-page: rgb(250 246 240);

    --aw-color-bg-page-dark: rgb(44 24 16);
    --aw-color-line: rgb(230 216 204);

    ::selection {
      background-color: rgb(230 216 204);
    }
  }

  .dark {
    --aw-font-sans: var(--font-source-sans);
    --aw-font-serif: var(--font-source-serif);
    --aw-font-heading: var(--font-source-serif);

    --aw-color-primary: rgb(196 120 100);
    --aw-color-secondary: rgb(139 58 42);
    --aw-color-accent: rgb(196 120 100);

    --aw-color-text-heading: rgb(250 246 240);
    --aw-color-text-default: rgb(250 246 240);
    --aw-color-text-muted: rgb(230 216 204 / 70%);
    --aw-color-bg-page: rgb(44 24 16);

    ::selection {
      background-color: rgb(110 44 32);
      color: rgb(250 246 240);
    }
  }
</style>
