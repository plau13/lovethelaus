---
/** Marketing-site forgot-password form with submit spinner and sent success state. */
const sentMessage = 'If that email has an account, a reset link is on its way. Check your inbox.';
---

<div id="forgot-password-panel" class="forgot-password-panel">
  <div id="forgot-password-success" class="auth-success" hidden>
    <div class="auth-success-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>
    <p class="auth-success-message">{sentMessage}</p>
  </div>

  <form id="forgot-password-form" action="/kitchen/api/auth/forgot-password" method="post" class="grid gap-4">
    <input type="hidden" name="returnTo" value="/kitchen/forgot-password" />
    <label class="auth-label">
      <span>Email</span>
      <input class="auth-input" type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
    </label>
    <button type="submit" id="forgot-password-submit" class="auth-btn auth-btn-with-spinner">
      <span class="auth-btn-label">Send reset link</span>
      <span class="auth-btn-spinner" hidden aria-hidden="true">
        <svg class="auth-spinner" viewBox="0 0 24 24" fill="none">
          <circle class="auth-spinner-track" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path
            class="auth-spinner-head"
            fill="currentColor"
            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
          ></path>
        </svg>
      </span>
      <span class="auth-btn-pending-label" hidden>Sending…</span>
    </button>
  </form>
</div>

<script>
  (function initForgotPasswordForm() {
    const panel = document.getElementById('forgot-password-panel');
    const form = document.getElementById('forgot-password-form');
    const success = document.getElementById('forgot-password-success');
    const submit = document.getElementById('forgot-password-submit');
    if (!panel || !form || !success || !(submit instanceof HTMLButtonElement)) {
      return;
    }
    // Rebind so the narrowed types survive into the nested functions below.
    const formEl = form;
    const successEl = success;
    const submitButton = submit;

    function showSuccess() {
      formEl.hidden = true;
      successEl.hidden = false;
    }

    function setPending(pending: boolean) {
      submitButton.disabled = pending;
      submitButton.setAttribute('aria-busy', pending ? 'true' : 'false');
      submitButton.classList.toggle('auth-btn-pending', pending);
      const label = submitButton.querySelector('.auth-btn-label');
      const spinner = submitButton.querySelector('.auth-btn-spinner');
      const pendingLabel = submitButton.querySelector('.auth-btn-pending-label');
      if (label instanceof HTMLElement) {
        label.hidden = pending;
      }
      if (spinner instanceof HTMLElement) {
        spinner.hidden = !pending;
      }
      if (pendingLabel instanceof HTMLElement) {
        pendingLabel.hidden = !pending;
      }
    }

    const params = new URLSearchParams(window.location.search);
    if (params.get('sent') === '1') {
      showSuccess();
    }

    form.addEventListener('submit', () => {
      setPending(true);
    });
  })();
</script>
