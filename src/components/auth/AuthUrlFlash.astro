---
/**
 * Static auth pages cannot read ?error= at build time. This script renders flash
 * messages from the URL on load so API redirects remain visible to users.
 */
export interface Props {
  /** When `sent` query param equals this, show `sentMessage`. */
  sentValue?: string;
  sentMessage?: string;
  /** Hide the first form sibling after the flash root (one-time login success). */
  hideFormOnSent?: boolean;
}

const { sentValue = '1', sentMessage, hideFormOnSent = false } = Astro.props;
---

<div
  id="auth-url-flash"
  class="auth-url-flash"
  data-sent-value={sentValue}
  data-sent-message={sentMessage ?? ''}
  data-hide-form={hideFormOnSent ? '1' : '0'}
>
</div>

<script>
  (function showAuthUrlFlash() {
    const root = document.getElementById('auth-url-flash');
    if (!root) {
      return;
    }

    const params = new URLSearchParams(window.location.search);

    const error = params.get('error')?.trim();
    if (error) {
      const alert = document.createElement('p');
      alert.className = 'auth-error';
      alert.setAttribute('role', 'alert');
      alert.textContent = error;
      root.appendChild(alert);
    }

    const sent = params.get('sent');
    const expectedSent = root.dataset.sentValue ?? '1';
    const sentMessage = root.dataset.sentMessage?.trim();
    if (sent === expectedSent && sentMessage) {
      const notice = document.createElement('p');
      notice.className = 'auth-notice';
      notice.textContent = sentMessage;
      root.appendChild(notice);

      if (root.dataset.hideForm === '1') {
        const card = root.closest('.auth-card');
        const form = card?.querySelector('form');
        if (form instanceof HTMLElement) {
          form.hidden = true;
        }
        const title = card?.querySelector('.auth-card-header h1');
        const description = card?.querySelector('.auth-card-description');
        if (sent === 'magic-link' && title) {
          title.textContent = 'Check your email to log in';
        }
        if (sent === 'magic-link' && description) {
          description.textContent =
            'We sent a sign-in link to your email. Open it from this device to continue. Check your spam folder if it does not arrive within a few minutes.';
        }
      }
    }

    const email = params.get('email')?.trim();
    if (email) {
      const input = document.querySelector('input[name="email"]');
      if (input instanceof HTMLInputElement && !input.value) {
        input.value = email;
      }
    }
  })();
</script>
