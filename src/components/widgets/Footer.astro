---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], links = [], footNote = '' } = Astro.props;
const year = new Date().getFullYear();
const siteHost = SITE?.site?.replace(/^https?:\/\//, '') ?? 'lovethelaus.com';
const copyright = footNote || `© ${year} ${SITE?.name ?? 'Kitchen'} · ${siteHost}`;
---

<footer class="relative border-t border-[color:var(--aw-color-line)] bg-page not-prose">
  <div
    class="relative max-w-7xl mx-auto px-4 sm:px-6 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
  >
    <div class="grid grid-cols-1 gap-10 py-12 md:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <a class="inline-flex items-center gap-2 font-heading text-xl font-bold text-default" href={getHomePermalink()}>
          <Icon name="tabler:chef-hat" class="h-6 w-6 text-primary" aria-hidden="true" />
          {SITE?.name}
        </a>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted">
          Family recipes, yours to keep. Save, cook, and share without losing what matters.
        </p>
      </div>
      {
        links.map(({ title, links: columnLinks }) => (
          <div class="lg:col-span-2">
            <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-default">{title}</p>
            {columnLinks?.length ? (
              <ul class="space-y-2 text-sm">
                {columnLinks.map(({ text, href, ariaLabel }) => (
                  <li>
                    <a
                      class="text-muted transition hover:text-primary hover:underline"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      {text}
                    </a>
                  </li>
                ))}
              </ul>
            ) : null}
          </div>
        ))
      }
    </div>
    <div class="flex flex-col gap-4 border-t border-[color:var(--aw-color-line)] py-6 md:flex-row md:items-center md:justify-between">
      <p class="text-sm text-muted">{copyright}</p>
      {
        socialLinks?.length ? (
          <ul class="flex gap-1">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a
                  class="inline-flex items-center rounded-lg p-2.5 text-muted transition hover:bg-[color:var(--aw-color-line)]/40 hover:text-primary focus:outline-none focus:ring-4 focus:ring-primary/30"
                  aria-label={ariaLabel}
                  href={href}
                >
                  {icon ? <Icon name={icon} class="h-5 w-5" /> : null}
                  {text}
                </a>
              </li>
            ))}
          </ul>
        ) : null
      }
    </div>
  </div>
</footer>
