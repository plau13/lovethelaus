---
import { Icon } from 'astro-icon/components';

import { UI } from 'astrowind:config';

export interface Props {
  label?: string;
  class?: string;
  iconClass?: string;
}

const {
  label = 'Switch to dark mode',
  class:
    className = 'text-muted hover:bg-[color:var(--aw-color-line)]/40 focus:outline-none focus:ring-4 focus:ring-primary/30 rounded-lg text-sm p-2.5 inline-flex items-center',
  iconClass = 'w-6 h-6',
} = Astro.props;
---

{
  !(UI.theme && UI.theme.endsWith(':only')) && (
    <aw-theme-toggle>
      <button
        type="button"
        class={className}
        aria-label={label}
        aria-pressed="false"
        data-aw-toggle-color-scheme
      >
        <Icon name="tabler:sun" class={iconClass} data-aw-icon-light />
        <Icon name="tabler:moon" class={iconClass} data-aw-icon-dark />
      </button>
    </aw-theme-toggle>
  )
}

<style>
  aw-theme-toggle {
    display: contents;
  }

  [data-aw-icon-dark] {
    display: none;
  }

  :global(.dark) [data-aw-icon-light] {
    display: none;
  }

  :global(.dark) [data-aw-icon-dark] {
    display: inline-flex;
  }
</style>

<script>
  class AwThemeToggle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>('[data-aw-toggle-color-scheme]');
      const syncLabel = (isDark: boolean) => {
        button?.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
        button?.setAttribute('aria-pressed', String(isDark));
      };

      syncLabel(document.documentElement.classList.contains('dark'));

      button?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.theme = isDark ? 'dark' : 'light';
        syncLabel(isDark);
        document.dispatchEvent(new CustomEvent('aw:theme-change'));
      });
    }
  }

  if (!customElements.get('aw-theme-toggle')) {
    customElements.define('aw-theme-toggle', AwThemeToggle);
  }
</script>
