---
import Layout from '~/layouts/Layout.astro';
import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  title: string;
  description?: string;
}

const { metadata, title, description } = Astro.props;
---

<Layout metadata={metadata}>
  <div class="min-h-[70vh] bg-page">
    <header class="mx-auto flex max-w-lg items-center justify-between px-4 py-6">
      <a href="/" class="font-heading text-xl font-semibold text-default">Kitchen</a>
      <a href="/" class="text-sm text-muted hover:text-primary">Home</a>
    </header>
    <main class="mx-auto grid max-w-lg gap-6 px-4 pb-16">
      <div class="grid gap-2">
        <h1 class="font-heading text-4xl font-bold text-default">{title}</h1>
        {description ? <p class="text-muted">{description}</p> : null}
      </div>
      <slot />
    </main>
  </div>
</Layout>

<style>
  .auth-input {
    border: 1px solid var(--aw-color-line, rgb(230 216 204));
    border-radius: 0.75rem;
    background: white;
    padding: 0.75rem;
    width: 100%;
    font-size: 1rem;
  }
  .auth-label {
    display: grid;
    gap: 0.25rem;
  }
  .auth-btn {
    border-radius: 0.75rem;
    background: rgb(139 58 42);
    color: white;
    padding: 0.75rem 1.25rem;
    font-size: 1.125rem;
    min-height: 3rem;
  }
  .auth-btn:hover {
    background: rgb(110 44 32);
  }
  .auth-btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    border: 1px solid var(--aw-color-line, rgb(230 216 204));
    background: white;
    color: rgb(139 58 42);
    padding: 0.75rem 1.25rem;
    font-size: 1.125rem;
    min-height: 3rem;
    text-decoration: none;
  }
  .auth-btn-outline:hover {
    border-color: rgb(139 58 42);
  }
  .auth-footer {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--aw-color-muted, rgb(107 93 82));
  }
  .auth-notice {
    border: 1px solid var(--aw-color-line, rgb(230 216 204));
    border-radius: 0.75rem;
    background: white;
    padding: 1rem;
  }
  .auth-error {
    border: 1px solid var(--aw-color-line, rgb(230 216 204));
    border-radius: 0.75rem;
    background: white;
    padding: 1rem;
    color: rgb(139 58 42);
  }
</style>
