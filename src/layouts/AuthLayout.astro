---
import Layout from '~/layouts/Layout.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  title: string;
  description?: string;
}

const { metadata, title, description } = Astro.props;
---

<Layout metadata={metadata}>
  <div class="flex min-h-screen flex-col bg-page">
    <header class="mx-auto flex w-full max-w-md items-center justify-between px-4 py-6">
      <a href="/" class="font-heading text-xl font-semibold text-default">Kitchen</a>
      <ToggleTheme iconClass="w-5 h-5" />
    </header>
    <main class="mx-auto flex w-full max-w-md flex-1 flex-col px-4 pb-16">
      <div class="auth-card">
        <div class="auth-card-header">
          <h1 class="font-heading text-3xl font-bold text-default">{title}</h1>
          {description ? <p class="auth-card-description">{description}</p> : null}
        </div>
        <slot />
      </div>
    </main>
  </div>
</Layout>

<style is:global>
  .auth-card {
    display: grid;
    gap: 1.5rem;
    border: 1px solid var(--aw-color-line, rgb(230 216 204));
    border-radius: 1rem;
    background: white;
    padding: 1.75rem;
    box-shadow: 0 0.375rem 1.5rem rgb(44 24 16 / 8%);
  }

  .dark .auth-card {
    background: rgb(110 44 32 / 15%);
    box-shadow: none;
  }

  .auth-card-header {
    display: grid;
    gap: 0.5rem;
  }

  .auth-card-description {
    color: var(--aw-color-text-muted, rgb(107 83 72));
    line-height: 1.5;
  }

  .auth-label {
    display: grid;
    gap: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--aw-color-text-default, rgb(44 24 16));
  }

  .auth-input {
    border: 1px solid var(--aw-color-line, rgb(230 216 204));
    border-radius: 0.75rem;
    background: white;
    padding: 0.75rem;
    width: 100%;
    font-size: 1rem;
    color: var(--aw-color-text-default, rgb(44 24 16));
  }

  .dark .auth-input {
    background: rgb(44 24 16 / 40%);
    color: var(--aw-color-text-default, rgb(250 246 240));
  }

  .auth-input:focus {
    outline: 2px solid rgb(139 58 42 / 35%);
    outline-offset: 2px;
  }

  .auth-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    border: none;
    border-radius: 0.75rem;
    background: rgb(139 58 42);
    color: white;
    padding: 0.75rem 1.25rem;
    font-size: 1.125rem;
    min-height: 3rem;
    cursor: pointer;
  }

  .auth-btn:hover {
    background: rgb(110 44 32);
  }

  .auth-btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    border-radius: 0.75rem;
    border: 1px solid var(--aw-color-line, rgb(230 216 204));
    background: white;
    color: rgb(139 58 42);
    padding: 0.75rem 1.25rem;
    font-size: 1.125rem;
    min-height: 3rem;
    text-decoration: none;
  }

  .dark .auth-btn-outline {
    background: transparent;
    color: rgb(196 120 100);
  }

  .auth-btn-outline:hover {
    border-color: rgb(139 58 42);
  }

  .auth-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--aw-color-text-muted, rgb(107 93 82));
  }

  .auth-footer a {
    color: rgb(139 58 42);
    text-decoration: none;
  }

  .dark .auth-footer a {
    color: rgb(196 120 100);
  }

  .auth-footer a:hover {
    text-decoration: underline;
  }

  .auth-notice {
    border: 1px solid var(--aw-color-line, rgb(230 216 204));
    border-radius: 0.75rem;
    background: white;
    padding: 1rem;
    line-height: 1.5;
  }

  .dark .auth-notice {
    background: rgb(44 24 16 / 40%);
  }

  .auth-url-flash {
    display: grid;
    gap: 1rem;
  }

  .auth-success {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 0;
    text-align: center;
  }

  .auth-success-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border-radius: 9999px;
    background: rgb(209 250 229);
    color: rgb(5 150 105);
  }

  .auth-success-icon svg {
    width: 2rem;
    height: 2rem;
  }

  .auth-success-message {
    margin: 0;
    color: var(--aw-color-text-muted, rgb(107 93 82));
    line-height: 1.5;
  }

  .auth-btn-with-spinner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .auth-btn-pending {
    cursor: wait;
    opacity: 0.92;
  }

  .auth-spinner {
    width: 1.25rem;
    height: 1.25rem;
    animation: auth-spin 0.8s linear infinite;
  }

  .auth-spinner-track {
    opacity: 0.25;
  }

  .auth-spinner-head {
    opacity: 0.85;
  }

  @keyframes auth-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .auth-error {
    border: 1px solid var(--aw-color-line, rgb(230 216 204));
    border-radius: 0.75rem;
    background: white;
    padding: 1rem;
    color: rgb(139 58 42);
    line-height: 1.5;
  }

  .dark .auth-error {
    background: rgb(44 24 16 / 40%);
  }
</style>
