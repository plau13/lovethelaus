---
import AuthLayout from '~/layouts/AuthLayout.astro';
import AuthUrlFlash from '~/components/auth/AuthUrlFlash.astro';
import ForgotPasswordForm from '~/components/auth/ForgotPasswordForm.astro';

const metadata = {
  title: 'Forgot password — Kitchen',
  description: 'Reset your Kitchen account password.',
};
---

<AuthLayout
  metadata={metadata}
  title="Forgot password"
  description="We'll email a link to reset your password. The link opens Kitchen to set a new one."
>
  <AuthUrlFlash />
  <ForgotPasswordForm />
  <div class="auth-footer">
    <a href="/sign-in">Back to sign in</a>
  </div>
</AuthLayout>
