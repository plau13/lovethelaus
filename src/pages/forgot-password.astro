---
import AuthLayout from '~/layouts/AuthLayout.astro';
import AuthUrlFlash from '~/components/auth/AuthUrlFlash.astro';

const metadata = {
  title: 'Forgot password — Kitchen',
  description: 'Reset your Kitchen account password.',
};
---

<AuthLayout
  metadata={metadata}
  title="Forgot password"
  description="We'll email a link to reset your password. The link opens Kitchen to set a new one."
>
  <AuthUrlFlash
    sentMessage="If that email has an account, a reset link is on its way. Check your inbox."
  />
  <form action="/kitchen/api/auth/forgot-password" method="post" class="grid gap-4">
    <input type="hidden" name="returnTo" value="/kitchen/forgot-password" />
    <label class="auth-label">
      <span>Email</span>
      <input class="auth-input" type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
    </label>
    <button type="submit" class="auth-btn">Send reset link</button>
  </form>
  <div class="auth-footer">
    <a href="/sign-in">Back to sign in</a>
  </div>
</AuthLayout>
