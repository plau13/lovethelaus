---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const kitchenUrl = import.meta.env.PUBLIC_KITCHEN_URL ?? 'http://localhost:3000';

const metadata = {
  title: 'Love the Laus — family recipes',
  description:
    'The recipe box your family actually uses — save from anywhere, cook on iPhone or iPad, share cookbooks with a link, and export everything if you ever leave.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Open Kitchen',
        href: kitchenUrl,
        target: '_blank',
        icon: 'tabler:chef-hat',
      },
      { text: 'See how it works', href: '#how-it-works' },
    ]}
  >
    <Fragment slot="title">
      Family recipes that <span class="text-accent dark:text-white">never disappear</span>
    </Fragment>

    <Fragment slot="subtitle">
      The recipe box your family actually uses — save from anywhere, cook on iPhone or iPad, share cookbooks with a
      link, and export everything if you ever leave.
    </Fragment>
  </Hero>

  <Features
    id="features"
    tagline="Kitchen"
    title="Save, cook, share"
    subtitle="A private recipe box for the family — not another recipe blog."
    columns={3}
    items={[
      {
        title: 'Save',
        description:
          'Type recipes, add photos and tags, or paste a link from a food blog or social post. Every recipe keeps its source. Export JSON or CSV anytime.',
        icon: 'tabler:bookmark',
      },
      {
        title: 'Cook',
        description:
          'Kitchen mode on iPhone or iPad: large type, check off ingredients, screen stays awake. No ads between you and dinner.',
        icon: 'tabler:device-mobile',
      },
      {
        title: 'Share',
        description:
          'Personal cookbooks with invite links. Family leaves notes without changing your recipe. Public books only when you choose.',
        icon: 'tabler:users',
      },
    ]}
  />

  <Steps
    id="how-it-works"
    tagline="Three steps"
    title="How it works"
    subtitle="From scattered screenshots to a cookbook everyone can cook from."
    isReversed
    items={[
      {
        title: 'Add recipes',
        description:
          'Type them in, paste a food-blog URL, or import from Instagram or TikTok — then fix the draft before you save.',
        icon: 'tabler:plus',
      },
      {
        title: 'Cook from the kitchen',
        description:
          'Open cook mode on your phone or iPad: big type, ingredient checkboxes, and a screen that stays awake while you work.',
        icon: 'tabler:chef-hat',
      },
      {
        title: 'Share the cookbook',
        description:
          'Invite family with a link. They can view, leave notes, or copy a recipe into their own book — without overwriting yours.',
        icon: 'tabler:link',
      },
    ]}
  />

  <Content
    id="kitchen"
    tagline="Built for real kitchens"
    title="Made for the counter, not the desk"
    subtitle="Mom cooks from an iPhone in one hand and an iPad on the counter. Kitchen is designed for that."
    columns={2}
    items={[
      {
        title: 'iPhone and iPad first',
        description: 'Large text, touch-friendly controls, and a home-screen app — no App Store required.',
        icon: 'tabler:device-tablet',
      },
      {
        title: 'Export is always free',
        description: 'Download every recipe as JSON or CSV. Your collection is yours, even if you stop using the site.',
        icon: 'tabler:download',
      },
      {
        title: 'No ads in cook mode',
        description:
          'The kitchen view is just ingredients and steps. Nothing to tap by accident while your hands are messy.',
        icon: 'tabler:ban',
      },
      {
        title: 'Private by default',
        description: 'Family recipes stay in your account until you share a cookbook or make one public on purpose.',
        icon: 'tabler:lock',
      },
    ]}
  />

  <FAQs
    id="faq"
    tagline="FAQ"
    title="Questions families ask"
    subtitle="Straight answers — no fine print hiding the export button."
    columns={2}
    items={[
      {
        title: 'Can I get my recipes out if I leave?',
        description: 'Yes. Export JSON or CSV from Kitchen anytime. That is a core promise — not a paid upgrade.',
        icon: 'tabler:download',
      },
      {
        title: 'Does Instagram or TikTok import work automatically?',
        description:
          'Paste a link and Kitchen drafts ingredients and steps from the caption. You confirm before saving. We keep the original link; we do not re-host the video.',
        icon: 'tabler:brand-instagram',
      },
      {
        title: 'Can my sister edit my recipes?',
        description:
          'Only if you own the recipe. Shared cookbooks let family leave notes or copy a recipe into their own book — they cannot change your version.',
        icon: 'tabler:notes',
      },
      {
        title: 'Do I need Wi-Fi while I cook?',
        description:
          'Cook mode works best online today. Offline support is on the roadmap; export gives you a backup until then.',
        icon: 'tabler:wifi',
      },
      {
        title: 'Is this just for our family?',
        description:
          'It starts that way. You can share private cookbooks with invite links, or publish a public book when you are ready.',
        icon: 'tabler:home-heart',
      },
      {
        title: 'How do I sign in?',
        description:
          'Email magic link — no password to forget. Add Kitchen to your iPhone or iPad home screen from Safari.',
        icon: 'tabler:mail',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Open Kitchen',
        href: kitchenUrl,
        target: '_blank',
        icon: 'tabler:chef-hat',
      },
    ]}
  >
    <Fragment slot="title">Ready to save the recipes that matter?</Fragment>
    <Fragment slot="subtitle"
      >Start with a few favorites. Export whenever you want. Share when the family is ready.</Fragment
    >
  </CallToAction>
</Layout>
