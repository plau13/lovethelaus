---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import SurveyEmbed from '~/components/widgets/SurveyEmbed.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const kitchenUrl = import.meta.env.PUBLIC_KITCHEN_URL ?? 'http://localhost:3000/kitchen';

const metadata = {
  title: 'Kitchen — family recipes',
  description:
    'The recipe box your family actually uses — save from anywhere, cook on iPhone or iPad, share cookbooks with a link, and export your own recipes anytime.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Open Kitchen',
        href: kitchenUrl,
        target: '_blank',
        icon: 'tabler:chef-hat',
      },
      { text: 'See how it works', href: '#how-it-works' },
    ]}
  >
    <Fragment slot="title">
      Family recipes that <span class="text-accent dark:text-white">never disappear</span>
    </Fragment>

    <Fragment slot="subtitle">
      The recipe box your family actually uses — save from anywhere, cook on iPhone or iPad, share cookbooks with a
      link, and export your own recipes anytime.
    </Fragment>
  </Hero>

  <Features
    id="features"
    tagline="Kitchen"
    title="Save, cook, share"
    subtitle="A private recipe box for the family — not another recipe blog."
    columns={3}
    items={[
      {
        title: 'Save',
        description:
          'Type recipes, add photos and tags, or paste a link from a food blog or social post. Instagram and TikTok imports read the caption (video analysis coming). Free: 3 social imports; subscribers get more.',
        icon: 'tabler:bookmark',
      },
      {
        title: 'Cook',
        description:
          'Kitchen mode on iPhone or iPad: large type, check off ingredients, screen stays awake. Subscribers can cook offline. No ads between you and dinner.',
        icon: 'tabler:device-mobile',
      },
      {
        title: 'Share',
        description:
          'Invite family with view, comment, or edit access per recipe. Version history tracks every change. Public cookbooks only when you choose.',
        icon: 'tabler:users',
      },
    ]}
  />

  <Steps
    id="how-it-works"
    tagline="Three steps"
    title="How it works"
    subtitle="From scattered screenshots to a cookbook everyone can cook from."
    isReversed
    items={[
      {
        title: 'Add recipes',
        description:
          'Type them in, paste a food-blog URL, or import from Instagram or TikTok — caption today, video analysis planned — then fix the draft before you save.',
        icon: 'tabler:plus',
      },
      {
        title: 'Cook from the kitchen',
        description:
          'Open cook mode on your phone or iPad: big type, ingredient checkboxes, and a screen that stays awake while you work.',
        icon: 'tabler:chef-hat',
      },
      {
        title: 'Share the cookbook',
        description:
          'Invite family with a link. Grant view, comment, or edit access per recipe — with version history for every change.',
        icon: 'tabler:link',
      },
    ]}
  />

  <Content
    id="kitchen"
    tagline="Built for real kitchens"
    title="Made for the counter, not the desk"
    subtitle="Designed for cooking from an iPhone in one hand and an iPad on the counter."
    columns={2}
    items={[
      {
        title: 'iPhone and iPad first',
        description: 'Large text, touch-friendly controls, and a home-screen app — no App Store required.',
        icon: 'tabler:device-tablet',
      },
      {
        title: 'Export your recipes',
        description:
          'Download recipes you own as JSON or CSV anytime. Export others&apos; shared recipes with a subscription.',
        icon: 'tabler:download',
      },
      {
        title: 'No ads in cook mode',
        description:
          'The kitchen view is just ingredients and steps. Nothing to tap by accident while your hands are messy.',
        icon: 'tabler:ban',
      },
      {
        title: 'Private by default',
        description:
          'Family recipes stay in your account until you share a cookbook, grant recipe access, or make one public.',
        icon: 'tabler:lock',
      },
    ]}
  />

  <FAQs
    id="faq"
    tagline="FAQ"
    title="Questions families ask"
    subtitle="Straight answers — no fine print hiding the export button."
    columns={2}
    items={[
      {
        title: 'Can I get my recipes out if I leave?',
        description:
          'Yes. Export JSON or CSV for recipes you own — always free. With a subscription you can also export shared recipes others have granted you access to.',
        icon: 'tabler:download',
      },
      {
        title: 'Does Instagram or TikTok import work automatically?',
        description:
          'Paste a link and Kitchen drafts ingredients and steps from the caption. Video analysis is planned. Free accounts get 3 social imports (lifetime); subscribers get about 5–10 per month. You confirm before saving.',
        icon: 'tabler:brand-instagram',
      },
      {
        title: 'Can my sister edit my recipes?',
        description:
          'You choose per recipe: view, comment, or edit access. Editors can change the card; everyone else can leave notes. Version history keeps a record of changes.',
        icon: 'tabler:notes',
      },
      {
        title: 'Do I need Wi-Fi while I cook?',
        description:
          'Subscribers can use offline cook mode — recipes cache on your device. Free accounts need a connection today.',
        icon: 'tabler:wifi',
      },
      {
        title: 'Is this just for our family?',
        description:
          'It starts that way. You can share private cookbooks with invite links, or publish a public book when you are ready.',
        icon: 'tabler:home-heart',
      },
      {
        title: 'How do I sign in?',
        description:
          'Email and password, or a magic link to your inbox. Sign in with Apple or Google is coming soon. Add Kitchen to your home screen from Safari.',
        icon: 'tabler:mail',
      },
    ]}
  />

  <SurveyEmbed
    id="survey"
    tagline="Feedback"
    title="Tell us what you think"
    subtitle="Help shape Kitchen — this short survey takes a few minutes."
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Open Kitchen',
        href: kitchenUrl,
        target: '_blank',
        icon: 'tabler:chef-hat',
      },
    ]}
  >
    <Fragment slot="title">Ready to save the recipes that matter?</Fragment>
    <Fragment slot="subtitle"
      >Start with a few favorites. Export whenever you want. Share when the family is ready.</Fragment
    >
  </CallToAction>
</Layout>
