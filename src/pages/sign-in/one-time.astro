---
import AuthLayout from '~/layouts/AuthLayout.astro';

const error = Astro.url.searchParams.get('error');
const sent = Astro.url.searchParams.get('sent');
const isSuccess = sent === 'magic-link';
const metadata = {
  title: isSuccess ? 'Check your email — Kitchen' : 'One-time login — Kitchen',
  description: isSuccess
    ? 'We sent you a sign-in link. Check your inbox to log in.'
    : 'Sign in to Kitchen with a one-time email link.',
};
---

<AuthLayout
  metadata={metadata}
  title={isSuccess ? 'Check your email to log in' : 'One-time login'}
  description={
    isSuccess
      ? 'We sent a sign-in link to your email. Open it from this device to continue. Check your spam folder if it does not arrive within a few minutes.'
      : "Enter your email and we'll send you a link to sign in."
  }
>
  {error ? <p class="auth-error">{error}</p> : null}
  {isSuccess ? (
    <p class="auth-notice">The link expires after a short time. You can close this page once you are signed in.</p>
  ) : (
    <form action="/kitchen/api/auth/magic-link" method="post" class="grid gap-4">
      <input type="hidden" name="returnTo" value="/sign-in/one-time" />
      <label class="auth-label">
        <span>Email</span>
        <input class="auth-input" type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
      </label>
      <button type="submit" class="auth-btn">Send one-time login</button>
    </form>
  )}
  <div class="auth-footer">
    <a href="/sign-in">Back to sign in</a>
  </div>
</AuthLayout>
