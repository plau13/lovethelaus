---
import AuthLayout from '~/layouts/AuthLayout.astro';
import AuthUrlFlash from '~/components/auth/AuthUrlFlash.astro';

const metadata = {
  title: 'One-time login — Kitchen',
  description: 'Sign in to Kitchen with a one-time email link.',
};
---

<AuthLayout
  metadata={metadata}
  title="One-time login"
  description="Enter your email and we'll send you a link to sign in."
>
  <AuthUrlFlash
    sentValue="magic-link"
    sentMessage="The link expires after a short time. You can close this page once you are signed in."
    hideFormOnSent={true}
  />
  <form action="/kitchen/api/auth/magic-link" method="post" class="grid gap-4">
    <input type="hidden" name="returnTo" value="/kitchen/sign-in/one-time" />
    <label class="auth-label">
      <span>Email</span>
      <input class="auth-input" type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
    </label>
    <button type="submit" class="auth-btn"> Send one-time login </button>
  </form>
  <div class="auth-footer">
    <a href="/sign-in">Back to sign in</a>
  </div>
</AuthLayout>
