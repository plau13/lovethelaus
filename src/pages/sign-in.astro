---
import AuthLayout from '~/layouts/AuthLayout.astro';
import AuthUrlFlash from '~/components/auth/AuthUrlFlash.astro';

const metadata = {
  title: 'Sign in — Kitchen',
  description: 'Sign in to your family Kitchen recipe box.',
};
---

<AuthLayout metadata={metadata} title="Sign in" description="Welcome back. Sign in with your email and password.">
  <AuthUrlFlash />
  <form action="/kitchen/api/auth/sign-in" method="post" class="grid gap-4">
    <input type="hidden" name="returnTo" value="/kitchen/sign-in" />
    <label class="auth-label">
      <span>Email</span>
      <input class="auth-input" type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
    </label>
    <label class="auth-label">
      <span>Password</span>
      <input class="auth-input" type="password" name="password" required autocomplete="current-password" />
    </label>
    <button type="submit" class="auth-btn">Sign in</button>
    <a href="/sign-in/one-time" class="auth-btn-outline">Send one-time login</a>
  </form>
  <div class="auth-footer">
    <a href="/sign-up">Create an account</a>
    <a href="/forgot-password">Forgot password?</a>
  </div>
</AuthLayout>
