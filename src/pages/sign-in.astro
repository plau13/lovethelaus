---
import AuthLayout from '~/layouts/AuthLayout.astro';

const error = Astro.url.searchParams.get('error');
const sent = Astro.url.searchParams.get('sent');
const errorMessage =
  error === 'demo-unavailable' ? 'Demo is not configured on this server.' : error;
const metadata = {
  title: 'Sign in — Kitchen',
  description: 'Sign in to your family Kitchen recipe box.',
};
---

<AuthLayout metadata={metadata} title="Sign in" description="Welcome back. Use email and password or a magic link.">
  {errorMessage ? <p class="auth-error">{errorMessage}</p> : null}
  {sent === 'magic-link' ? <p class="auth-notice">Check your email for a sign-in link.</p> : null}
  <form action="/kitchen/api/auth/sign-in" method="post" class="grid gap-4">
    <input type="hidden" name="returnTo" value="/sign-in" />
    <label class="auth-label">
      <span>Email</span>
      <input class="auth-input" type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
    </label>
    <label class="auth-label">
      <span>Password</span>
      <input class="auth-input" type="password" name="password" required autocomplete="current-password" />
    </label>
    <button type="submit" class="auth-btn">Sign in</button>
  </form>
  <form action="/kitchen/api/auth/magic-link" method="post" class="grid gap-4">
    <input type="hidden" name="returnTo" value="/sign-in" />
    <label class="auth-label">
      <span>Or email me a magic link</span>
      <input class="auth-input" type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
    </label>
    <button type="submit" class="auth-btn">Send magic link</button>
  </form>
  <button type="button" disabled class="auth-btn opacity-60">Sign in with Apple — coming soon</button>
  <button type="button" disabled class="auth-btn opacity-60">Sign in with Google — coming soon</button>
  <a href="/kitchen/api/auth/demo" class="auth-btn inline-flex items-center justify-center no-underline">Try demo</a>
  <p class="text-muted text-sm">
    <a href="/sign-up" class="text-primary hover:underline">Create an account</a>
    ·
    <a href="/forgot-password" class="text-primary hover:underline">Forgot password?</a>
  </p>
</AuthLayout>
