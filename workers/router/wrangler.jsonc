{
  "$schema": "../../kitchen/node_modules/wrangler/config-schema.json",
  "name": "lovethelaus",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "KITCHEN",
      "service": "kitchen",
    },
  ],
  "routes": [
    {
      "pattern": "lovethelaus.com",
      "custom_domain": true,
    },
  ],
}
